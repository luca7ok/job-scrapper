  "description": "Browser checks for the site: screenshots, tracker persistence, export/import, Gist sync (mocked).",
  "scripts": {
    "serve": "python3 gzserve.py ../../site 8766",
    "shots": "node shots.js ./shots http://127.0.0.1:8766/",
